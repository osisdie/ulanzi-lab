# ulanzi-lab — per-machine settings.
#
# Copy this file to `.env` (repo root) and edit, or keep several named copies such as
# `.env.work` / `.env.home` and run `scripts\setup.ps1 -EnvProfile work` to copy one into place.
# Every `.env*` file except this example is git-ignored: put organisation names, private repos,
# internal URLs and hostnames here, never in the code.
#
# The plugin reads .env when Ulanzi Studio starts it; scripts/make-profile.mjs reads it to lay out pages.
# After editing: `node scripts/make-profile.mjs --activate` (re-generates pages and restarts Ulanzi Studio).
# Real environment variables override values from this file.

# ---------------------------------------------------------------- runtime
# Node that runs the plugin when Studio's bundled one lacks security fixes. Empty = find one; "bundled" = Studio's.
ULANZI_LAB_NODE=
# Your own sounds JSON (same keys as plugin/.../config/sounds.<os>.json, the defaults; "off" mutes).
ULANZI_LAB_SOUNDS=

# ---------------------------------------------------------------- WSL
# Distro the plugin talks to. Empty = the default distro (`wsl -l -v`, the row marked *).
ULANZI_LAB_DISTRO=

# ---------------------------------------------------------------- code review (DevOps + Board pages)
# Which forge this machine uses for PRs/MRs, review requests and the review board:
#   gitlab  glab in WSL (self-hosted supported, see ULANZI_LAB_GITLAB_HOST)
#   github  gh in WSL (GitHub Enterprise: ULANZI_LAB_GITHUB_HOST)
#   auto    whichever CLI is logged in (GitLab first)
ULANZI_LAB_FORGE=auto

# GitLab host for glab. Empty = the host `glab auth status` reports as logged in.
ULANZI_LAB_GITLAB_HOST=

# GitHub host for gh (github.com or your GitHub Enterprise host).
ULANZI_LAB_GITHUB_HOST=github.com

# GitHub only: search qualifiers for the review board (every open PR in scope).
# Examples: involves:@me   org:my-org   repo:owner/name   user:me
ULANZI_LAB_BOARD_SCOPE=involves:@me

# GitHub only: repo for the Actions key (owner/name). Empty = repos of your open PRs.
ULANZI_LAB_ACTIONS_REPO=

# ---------------------------------------------------------------- DevOps page
# Up to two HTTP health checks, "url|label" comma-separated. Reachable (< 500) = UP.
# Empty = check the Claude API.
ULANZI_LAB_HTTP_CHECKS=

# n8n base URL for the n8n key.
ULANZI_LAB_N8N_URL=http://127.0.0.1:5678

# ---------------------------------------------------------------- pages
# Optional Watchlist page: up to 12 "SYMBOL:label" items (label optional). Empty = no page.
# Example: ^DJI:Dow,QQQ,NVDA:Nvidia,AAPL:Apple
ULANZI_LAB_WATCHLIST=
# Up to 3 items for the Watchlist page's wide key (rendered as mini candlesticks).
# Example: GC=F:Gold,SI=F:Silver,^TNX:US10Y
ULANZI_LAB_WATCHLIST_STRIP=

# ---------------------------------------------------------------- Voice profile (Windows)
# Where recordings and transcripts go. Empty = ~/ulanzi-lab/voice (C:\Users\<you>\ulanzi-lab\voice), not synced.
ULANZI_LAB_VOICE_DIR=
# ffmpeg.exe. Empty = PATH, then the usual winget / Chocolatey / Scoop locations.
ULANZI_LAB_FFMPEG=
# Microphone: part of its name. Empty = the Windows default recording device.
ULANZI_LAB_MIC=
# Longest recording in minutes.
ULANZI_LAB_REC_MAX_MIN=60
# Speech-to-text service (services/voice-asr). The plugin starts it in WSL when needed.
ULANZI_LAB_ASR_URL=http://127.0.0.1:39312
# Command that starts it (bash, in WSL). Empty = the repo's services/voice-asr/start.sh.
ULANZI_LAB_ASR_START=
# Copy each new transcript to the clipboard: on / off.
ULANZI_LAB_VOICE_CLIPBOARD=on

# ---------------------------------------------------------------- misc
# Hub port (WSL hooks POST here; keep in sync with ULANZI_HUB inside WSL if you change it).
ULANZI_LAB_PORT=39300
# Gap in pixels between snapped windows (Windows page).
ULANZI_LAB_GAP=0
